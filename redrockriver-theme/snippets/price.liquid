{%- comment -%}
  Preisanzeige. Parameter: product
{%- endcomment -%}
{%- liquid
  assign on_sale = false
  if product.compare_at_price > product.price and product.available
    assign on_sale = true
  endif
-%}
<div class="price{% if on_sale %} price--sale{% endif %}">
  {%- if on_sale -%}
    <span class="visually-hidden">{{ 'product.regular_price' | t }}</span>
    <s class="price__compare">{{ product.compare_at_price | money }}</s>
    <span class="visually-hidden">{{ 'product.sale_price' | t }}</span>
  {%- endif -%}
  <span class="price__current">
    {%- if product.price_varies %}{{ 'product.from' | t }} {% endif -%}
    {{ product.price | money }}
  </span>
</div>
