{%- comment -%}
  Icon-Snippet. Parameter: name (menu, search, user, bag, close, arrow-left, arrow-right, chevron)
{%- endcomment -%}
<svg class="icon icon--{{ name }}" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="square" aria-hidden="true" focusable="false">
  {%- case name -%}
    {%- when 'menu' -%}
      <path d="M3 7h18M3 12h18M3 17h18"/>
    {%- when 'search' -%}
      <circle cx="11" cy="11" r="6.5"/><path d="M16 16l5 5"/>
    {%- when 'user' -%}
      <circle cx="12" cy="8" r="4"/><path d="M4 21c0-4.4 3.6-7 8-7s8 2.6 8 7"/>
    {%- when 'bag' -%}
      <path d="M5 8h14l-1 13H6L5 8z"/><path d="M9 8V6a3 3 0 016 0v2"/>
    {%- when 'close' -%}
      <path d="M5 5l14 14M19 5L5 19"/>
    {%- when 'arrow-left' -%}
      <path d="M15 5l-7 7 7 7"/>
    {%- when 'arrow-right' -%}
      <path d="M9 5l7 7-7 7"/>
    {%- when 'chevron' -%}
      <path d="M6 9l6 6 6-6"/>
  {%- endcase -%}
</svg>
