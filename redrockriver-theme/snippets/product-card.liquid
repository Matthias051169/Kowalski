{%- comment -%}
  Produktkarte. Parameter: product (leer = Platzhalter), placeholder_index, sizes
{%- endcomment -%}
<article class="product-card">
  {%- if product != blank -%}
    <div class="product-card__wrap">
    <a class="product-card__media" href="{{ product.url }}" aria-hidden="true" tabindex="-1">
      {%- if product.featured_media -%}
        {{ product.featured_media | image_url: width: 900 | image_tag: loading: 'lazy', widths: '300, 450, 600, 900', sizes: sizes, class: 'product-card__img', alt: product.title }}
        {%- if product.media[1] -%}
          {{ product.media[1] | image_url: width: 900 | image_tag: loading: 'lazy', widths: '300, 450, 600, 900', sizes: sizes, class: 'product-card__img product-card__img--hover', alt: '' }}
        {%- endif -%}
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag: 'product-card__img placeholder' }}
      {%- endif -%}
      {%- if product.compare_at_price > product.price and product.available -%}
        <span class="badge badge--sale">{{ 'product.sale' | t }}</span>
      {%- elsif product.available == false -%}
        <span class="badge">{{ 'product.sold_out' | t }}</span>
      {%- endif -%}
    </a>
    <button class="wishlist-btn" type="button" data-wishlist-toggle data-handle="{{ product.handle }}" aria-pressed="false" data-label-add="{{ 'wishlist.add' | t }}" data-label-remove="{{ 'wishlist.remove' | t }}" aria-label="{{ 'wishlist.add' | t }}">
      {% render 'icon', name: 'heart' %}
    </button>
    </div>
    <div class="product-card__body">
      {%- if product.vendor != blank -%}<p class="product-card__vendor label">{{ product.vendor }}</p>{%- endif -%}
      <h3 class="product-card__title"><a href="{{ product.url }}">{{ product.title }}</a></h3>
      {% render 'price', product: product %}
    </div>
  {%- else -%}
    <div class="product-card__media" aria-hidden="true">
      {{ 'product-1' | placeholder_svg_tag: 'product-card__img placeholder' }}
      <span class="badge">{{ 'general.placeholder_note' | t }}</span>
    </div>
    <div class="product-card__body">
      <p class="product-card__vendor label">{{ 'general.placeholder_note' | t }}</p>
      <h3 class="product-card__title">Produktname {{ placeholder_index }}</h3>
      <div class="price"><span class="price__current">00,00 €</span></div>
    </div>
  {%- endif -%}
</article>
