<section class="section container">
  <header class="page-head">
    <h1 class="display-m">{{ blog.title | escape }}</h1>
  </header>
  {%- paginate blog.articles by section.settings.posts_per_page -%}
    {%- if blog.articles.size > 0 -%}
      <ul class="posts">
        {%- for article in blog.articles -%}
          <li class="post-card">
            <a class="post-card__media" href="{{ article.url }}" tabindex="-1" aria-hidden="true">
              {%- if article.image -%}
                {{ article.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400, 600, 900', sizes: '(min-width: 990px) 33vw, 100vw', alt: article.image.alt | default: article.title }}
              {%- else -%}
                {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder' }}
              {%- endif -%}
            </a>
            <p class="label post-card__meta">{{ article.published_at | date: '%d.%m.%Y' }}</p>
            <h2 class="post-card__title"><a href="{{ article.url }}">{{ article.title | escape }}</a></h2>
            <p>{{ article.excerpt_or_content | strip_html | truncate: 140 }}</p>
            <a class="link label" href="{{ article.url }}">{{ 'general.read_more' | t }}</a>
          </li>
        {%- endfor -%}
      </ul>
      {%- if paginate.pages > 1 -%}
        <nav class="pagination" aria-label="{{ 'collection.pagination' | t }}">
          {%- if paginate.previous -%}<a class="button button--small" href="{{ paginate.previous.url }}">{{ 'general.previous' | t }}</a>{%- endif -%}
          <span class="label">{{ paginate.current_page }} / {{ paginate.pages }}</span>
          {%- if paginate.next -%}<a class="button button--small" href="{{ paginate.next.url }}">{{ 'general.next' | t }}</a>{%- endif -%}
        </nav>
      {%- endif -%}
    {%- else -%}
      <p class="empty">{{ 'blog.empty' | t }}</p>
    {%- endif -%}
  {%- endpaginate -%}
</section>

{% schema %}
{
  "name": "Blog",
  "settings": [
    { "type": "range", "id": "posts_per_page", "min": 3, "max": 24, "step": 3, "label": "Beiträge pro Seite", "default": 9 }
  ]
}
{% endschema %}
