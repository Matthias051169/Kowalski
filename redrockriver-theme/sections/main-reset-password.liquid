<section class="section container auth">
  <div class="auth__box">
    <h1 class="display-m">{{ 'customer.reset.title' | t }}</h1>
    {%- form 'reset_customer_password', class: 'auth__form' -%}
      {%- if form.errors -%}
        <div class="form-status form-status--error" role="alert">{{ form.errors | default_errors }}</div>
      {%- endif -%}
      <label class="label" for="ResetPassword">{{ 'customer.reset.password' | t }}</label>
      <input class="field" type="password" id="ResetPassword" name="customer[password]" autocomplete="new-password" required>
      <label class="label" for="ResetPasswordConfirm">{{ 'customer.reset.confirm' | t }}</label>
      <input class="field" type="password" id="ResetPasswordConfirm" name="customer[password_confirmation]" autocomplete="new-password" required>
      <button class="button button--full" type="submit">{{ 'customer.reset.submit' | t }}</button>
    {%- endform -%}
  </div>
</section>

{% schema %}
{ "name": "Passwort zurücksetzen", "settings": [] }
{% endschema %}
