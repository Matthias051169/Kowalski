<section class="password">
  <div class="password__inner container">
    <p class="logo-text password__logo">{{ settings.logo_text | default: shop.name }}</p>
    <h1 class="display">{{ section.settings.heading | escape }}</h1>
    {%- if shop.password_message != blank -%}
      <div class="rte">{{ shop.password_message }}</div>
    {%- endif -%}

    <div class="password__enter">
      <h2 class="label">{{ 'password.enter' | t }}</h2>
      {%- form 'storefront_password', class: 'auth__form' -%}
        {%- if form.errors -%}
          <div class="form-status form-status--error" role="alert">{{ form.errors | default_errors }}</div>
        {%- endif -%}
        <label class="visually-hidden" for="PasswordInput">{{ 'password.password' | t }}</label>
        <input class="field" type="password" id="PasswordInput" name="password" autocomplete="current-password" placeholder="{{ 'password.password' | t }}" required>
        <button class="button" type="submit">{{ 'password.submit' | t }}</button>
      {%- endform -%}
      <p class="product__tax">{{ 'password.owner' | t }} <a class="link" href="/admin">{{ 'password.login' | t }}</a></p>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Passwortseite",
  "settings": [
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Bald verfügbar" }
  ]
}
{% endschema %}
