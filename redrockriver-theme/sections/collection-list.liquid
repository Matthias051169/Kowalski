<section class="section container">
  {%- if section.settings.heading != blank -%}
    <div class="section__head"><h2 class="headline">{{ section.settings.heading | escape }}</h2></div>
  {%- endif -%}
  <ul class="cats">
    {%- for block in section.blocks -%}
      {%- assign collection = block.settings.collection -%}
      <li class="cat" {{ block.shopify_attributes }}>
        <a class="cat__link" href="{{ collection.url | default: routes.all_products_collection_url }}">
          <div class="cat__media" aria-hidden="true">
            {%- if collection.image != blank -%}
              {{ collection.image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '300, 500, 800', sizes: '(min-width: 990px) 20vw, 46vw', class: 'cat__img', alt: '' }}
            {%- else -%}
              {{ 'collection-1' | placeholder_svg_tag: 'cat__img placeholder' }}
            {%- endif -%}
          </div>
          <span class="cat__title label">{{ block.settings.title | default: collection.title | default: 'Kategorie' }}</span>
        </a>
      </li>
    {%- endfor -%}
  </ul>
</section>

{% schema %}
{
  "name": "Kategorien",
  "max_blocks": 10,
  "settings": [
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Kategorien" }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Kategorie",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Kollektion" },
        { "type": "text", "id": "title", "label": "Titel (überschreibt Kollektionsnamen)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Kategorien",
      "blocks": [{ "type": "category" }, { "type": "category" }, { "type": "category" }, { "type": "category" }, { "type": "category" }]
    }
  ]
}
{% endschema %}
