<section class="section container">
  <div class="section__head">
    <h2 class="headline">{{ section.settings.heading | escape }}</h2>
  </div>

  <div class="carousel" data-carousel>
    <ul class="carousel__track looks" data-carousel-track>
      {%- for block in section.blocks -%}
        <li class="look" {{ block.shopify_attributes }}>
          <div class="look__media">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '400, 600, 800, 1000', sizes: '(min-width: 990px) 25vw, 70vw', class: 'look__img', alt: block.settings.title }}
            {%- else -%}
              {{ 'lifestyle-1' | placeholder_svg_tag: 'look__img placeholder' }}
            {%- endif -%}
          </div>
          <h3 class="look__title label">{{ block.settings.title | escape }}</h3>
          <p class="visually-hidden">{{ 'look.products' | t }}</p>
          <ul class="look__products">
            {%- assign has_products = false -%}
            {%- for i in (1..4) -%}
              {%- assign key = 'product_' | append: i -%}
              {%- assign look_product = block.settings[key] -%}
              {%- if look_product != blank -%}
                {%- assign has_products = true -%}
                <li class="look__product">
                  <a href="{{ look_product.url }}">
                    <span class="look__product-title">{{ look_product.title | escape }}</span>
                    <span class="look__product-price">{{ look_product.price | money }}</span>
                  </a>
                </li>
              {%- endif -%}
            {%- endfor -%}
            {%- unless has_products -%}
              {%- for i in (1..3) -%}
                <li class="look__product">
                  <span class="look__product-title">Produktname {{ i }}</span>
                  <span class="look__product-price">00,00 €</span>
                </li>
              {%- endfor -%}
            {%- endunless -%}
          </ul>
        </li>
      {%- endfor -%}
    </ul>
    <div class="carousel__controls">
      <button class="icon-btn" type="button" data-carousel-prev>{% render 'icon', name: 'arrow-left' %}<span class="visually-hidden">{{ 'general.previous' | t }}</span></button>
      <button class="icon-btn" type="button" data-carousel-next>{% render 'icon', name: 'arrow-right' %}<span class="visually-hidden">{{ 'general.next' | t }}</span></button>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Shop the Look",
  "max_blocks": 12,
  "settings": [
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Shop the Look" }
  ],
  "blocks": [
    {
      "type": "look",
      "name": "Look",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Bild" },
        { "type": "text", "id": "title", "label": "Titel", "default": "Look" },
        { "type": "product", "id": "product_1", "label": "Produkt 1" },
        { "type": "product", "id": "product_2", "label": "Produkt 2" },
        { "type": "product", "id": "product_3", "label": "Produkt 3" },
        { "type": "product", "id": "product_4", "label": "Produkt 4" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop the Look",
      "blocks": [{ "type": "look" }, { "type": "look" }, { "type": "look" }, { "type": "look" }]
    }
  ]
}
{% endschema %}
