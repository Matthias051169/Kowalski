<article class="section container article">
  <header class="article__head">
    <p class="label"><a class="link" href="{{ blog.url }}">{{ 'blog.back' | t }}</a></p>
    <h1 class="display-m">{{ article.title | escape }}</h1>
    <p class="label article__meta">
      {{ 'blog.published' | t: date: article.published_at | date: '%d.%m.%Y' }}
      {%- if article.author != blank %} &middot; {{ 'blog.by' | t: author: article.author }}{% endif -%}
    </p>
  </header>
  {%- if article.image -%}
    <div class="article__image">
      {{ article.image | image_url: width: 1600 | image_tag: loading: 'eager', widths: '600, 900, 1200, 1600', sizes: '(min-width: 990px) 60vw, 100vw', alt: article.image.alt | default: article.title }}
    </div>
  {%- endif -%}
  <div class="rte article__content">{{ article.content }}</div>
  {%- if article.tags.size > 0 -%}
    <ul class="article__tags">
      {%- for tag in article.tags -%}<li class="badge badge--static">{{ tag }}</li>{%- endfor -%}
    </ul>
  {%- endif -%}
</article>

{% schema %}
{ "name": "Artikel", "settings": [] }
{% endschema %}
