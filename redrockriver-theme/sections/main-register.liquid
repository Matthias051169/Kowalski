<section class="section container auth">
  <div class="auth__box">
    <h1 class="display-m">{{ 'customer.register.title' | t }}</h1>
    {%- form 'create_customer', novalidate: 'novalidate', class: 'auth__form' -%}
      {%- if form.errors -%}
        <div class="form-status form-status--error" role="alert">{{ form.errors | default_errors }}</div>
      {%- endif -%}
      <label class="label" for="RegisterFirstName">{{ 'customer.register.first_name' | t }}</label>
      <input class="field" type="text" id="RegisterFirstName" name="customer[first_name]" autocomplete="given-name">
      <label class="label" for="RegisterLastName">{{ 'customer.register.last_name' | t }}</label>
      <input class="field" type="text" id="RegisterLastName" name="customer[last_name]" autocomplete="family-name">
      <label class="label" for="RegisterEmail">{{ 'customer.register.email' | t }}</label>
      <input class="field" type="email" id="RegisterEmail" name="customer[email]" autocomplete="email" autocapitalize="off" required>
      <label class="label" for="RegisterPassword">{{ 'customer.register.password' | t }}</label>
      <input class="field" type="password" id="RegisterPassword" name="customer[password]" autocomplete="new-password" required>
      <button class="button button--full" type="submit">{{ 'customer.register.submit' | t }}</button>
    {%- endform -%}
    <p><a class="link label" href="{{ routes.account_login_url }}">{{ 'customer.register.have_account' | t }}</a></p>
  </div>
</section>

{% schema %}
{ "name": "Konto erstellen", "settings": [] }
{% endschema %}
