<section class="hero hero--{{ section.settings.height }}" style="--overlay: {{ section.settings.overlay | divided_by: 100.0 }};">
  <div class="hero__media" aria-hidden="true">
    {%- if section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 2400 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '750, 1100, 1500, 2000, 2400', sizes: '100vw', class: 'hero__img', alt: '' }}
    {%- else -%}
      {{ 'hero-apparel-1' | placeholder_svg_tag: 'hero__img placeholder' }}
    {%- endif -%}
  </div>
  <div class="hero__content container">
    {%- if section.settings.eyebrow != blank -%}
      <p class="hero__eyebrow label">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h1 class="hero__heading display">{{ section.settings.heading | escape }}</h1>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <p class="hero__text">{{ section.settings.text | escape }}</p>
    {%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <a class="button button--light" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label | escape }}</a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Bild" },
    { "type": "text", "id": "eyebrow", "label": "Kicker", "default": "PLATZHALTER" },
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Neue Kollektion" },
    { "type": "text", "id": "text", "label": "Text", "default": "Platzhaltertext. Hier steht später die Kampagnenbotschaft." },
    { "type": "text", "id": "button_label", "label": "Button-Text", "default": "Jetzt entdecken" },
    { "type": "url", "id": "button_link", "label": "Button-Link" },
    { "type": "range", "id": "overlay", "min": 0, "max": 70, "step": 5, "unit": "%", "label": "Abdunklung des Bildes", "default": 30 },
    {
      "type": "select", "id": "height", "label": "Höhe",
      "options": [
        { "value": "large", "label": "Groß" },
        { "value": "medium", "label": "Mittel" }
      ],
      "default": "large"
    }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
