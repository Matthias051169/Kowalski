{%- liquid
  assign limit = section.settings.products_count
  assign collection = section.settings.collection
-%}
<section class="section container">
  <div class="section__head">
    <h2 class="headline">{{ section.settings.heading | escape }}</h2>
    {%- if collection != blank -%}
      <a class="link label" href="{{ collection.url }}">{{ 'general.shop_all' | t }}</a>
    {%- endif -%}
  </div>

  <div class="carousel" data-carousel>
    <ul class="carousel__track" data-carousel-track>
      {%- if collection != blank and collection.products.size > 0 -%}
        {%- for product in collection.products limit: limit -%}
          <li class="carousel__item">{% render 'product-card', product: product, sizes: '(min-width: 990px) 25vw, 46vw' %}</li>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..limit) -%}
          <li class="carousel__item">{% render 'product-card', placeholder_index: i %}</li>
        {%- endfor -%}
      {%- endif -%}
    </ul>
    <div class="carousel__controls">
      <button class="icon-btn" type="button" data-carousel-prev>{% render 'icon', name: 'arrow-left' %}<span class="visually-hidden">{{ 'general.previous' | t }}</span></button>
      <button class="icon-btn" type="button" data-carousel-next>{% render 'icon', name: 'arrow-right' %}<span class="visually-hidden">{{ 'general.next' | t }}</span></button>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Produktreihe",
  "settings": [
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Neu im Shop" },
    { "type": "collection", "id": "collection", "label": "Kollektion" },
    { "type": "range", "id": "products_count", "min": 4, "max": 16, "step": 1, "label": "Anzahl Produkte", "default": 8 }
  ],
  "presets": [{ "name": "Produktreihe" }]
}
{% endschema %}
