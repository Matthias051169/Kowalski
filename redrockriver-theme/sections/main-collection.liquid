{%- paginate collection.products by section.settings.products_per_page -%}
<section class="section container">
  <header class="page-head">
    <h1 class="display-m">{{ collection.title | escape }}</h1>
    {%- if collection.description != blank -%}<div class="rte">{{ collection.description }}</div>{%- endif -%}
    <p class="label page-head__count">{{ 'collection.products_count' | t: count: collection.products_count }}</p>
  </header>

  <form class="toolbar" method="get" action="{{ collection.url }}" data-filter-form>
    {%- for filter in collection.filters -%}
      {%- if filter.type == 'price_range' -%}
        <details class="filter">
          <summary class="label">{{ filter.label | escape }} {% render 'icon', name: 'chevron' %}</summary>
          <div class="filter__body filter__body--price">
            <label>{{ 'collection.price_from' | t }}
              <input class="field" type="number" min="0" inputmode="decimal" name="{{ filter.min_value.param_name }}" value="{{ filter.min_value.value | money_without_currency | replace: ',', '.' }}" placeholder="0">
            </label>
            <label>{{ 'collection.price_to' | t }}
              <input class="field" type="number" min="0" inputmode="decimal" name="{{ filter.max_value.param_name }}" value="{{ filter.max_value.value | money_without_currency | replace: ',', '.' }}" placeholder="{{ filter.range_max | money_without_currency | replace: ',', '.' }}">
            </label>
          </div>
        </details>
      {%- else -%}
        <details class="filter"{% if filter.active_values.size > 0 %} open{% endif %}>
          <summary class="label">{{ filter.label | escape }} {% render 'icon', name: 'chevron' %}</summary>
          <ul class="filter__body">
            {%- for value in filter.values -%}
              <li>
                <label class="checkbox{% if value.count == 0 and value.active == false %} is-disabled{% endif %}">
                  <input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}"{% if value.active %} checked{% endif %}{% if value.count == 0 and value.active == false %} disabled{% endif %}>
                  <span>{{ value.label | escape }} ({{ value.count }})</span>
                </label>
              </li>
            {%- endfor -%}
          </ul>
        </details>
      {%- endif -%}
    {%- endfor -%}

    <label class="toolbar__sort label">
      <span>{{ 'collection.sort_by' | t }}</span>
      <select class="field" name="sort_by" data-sort-select>
        {%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}
        {%- for option in collection.sort_options -%}
          <option value="{{ option.value }}"{% if option.value == sort_by %} selected{% endif %}>{{ option.name | escape }}</option>
        {%- endfor -%}
      </select>
    </label>

    <div class="toolbar__actions">
      <button class="button button--small" type="submit">{{ 'collection.apply' | t }}</button>
      <a class="link label" href="{{ collection.url }}?sort_by={{ sort_by }}">{{ 'collection.reset' | t }}</a>
    </div>
  </form>

  {%- if collection.products.size > 0 -%}
    <ul class="grid">
      {%- for product in collection.products -%}
        <li>{% render 'product-card', product: product, sizes: '(min-width: 990px) 25vw, 46vw' %}</li>
      {%- endfor -%}
    </ul>
    {%- if paginate.pages > 1 -%}
      <nav class="pagination" aria-label="{{ 'collection.pagination' | t }}">
        {%- if paginate.previous -%}<a class="button button--small" href="{{ paginate.previous.url }}">{{ 'general.previous' | t }}</a>{%- endif -%}
        <span class="label">{{ paginate.current_page }} / {{ paginate.pages }}</span>
        {%- if paginate.next -%}<a class="button button--small" href="{{ paginate.next.url }}">{{ 'general.next' | t }}</a>{%- endif -%}
      </nav>
    {%- endif -%}
  {%- else -%}
    <p class="empty">{{ 'collection.empty' | t }}</p>
  {%- endif -%}
</section>
{%- endpaginate -%}

{% schema %}
{
  "name": "Kollektion",
  "settings": [
    { "type": "range", "id": "products_per_page", "min": 8, "max": 48, "step": 4, "label": "Produkte pro Seite", "default": 24 }
  ]
}
{% endschema %}
