<section class="section container">
  <div class="section__head">
    <h2 class="headline">{{ section.settings.heading | escape }}</h2>
  </div>
  <ul class="stores">
    {%- for block in section.blocks -%}
      <li class="store" {{ block.shopify_attributes }}>
        <div class="store__media" aria-hidden="true">
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '300, 500, 900', sizes: '(min-width: 990px) 33vw, 100vw', class: 'store__img', alt: '' }}
          {%- else -%}
            {{ 'lifestyle-2' | placeholder_svg_tag: 'store__img placeholder' }}
          {%- endif -%}
        </div>
        <h3 class="store__name label">{{ block.settings.name | escape }}</h3>
        {%- if block.settings.address != blank -%}<address class="store__address">{{ block.settings.address | escape | newline_to_br }}</address>{%- endif -%}
        {%- if block.settings.hours != blank -%}
          <p class="label store__hours-label">{{ 'stores.hours' | t }}</p>
          <p class="store__hours">{{ block.settings.hours | escape | newline_to_br }}</p>
        {%- endif -%}
        {%- if block.settings.link != blank -%}
          <a class="link label" href="{{ block.settings.link }}" rel="noopener" target="_blank">{{ 'stores.directions' | t }}</a>
        {%- endif -%}
      </li>
    {%- endfor -%}
  </ul>
</section>

{% schema %}
{
  "name": "Standorte",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Unsere Stores" }
  ],
  "blocks": [
    {
      "type": "store",
      "name": "Store",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Bild" },
        { "type": "text", "id": "name", "label": "Name", "default": "Store Stadt" },
        { "type": "textarea", "id": "address", "label": "Adresse", "default": "Platzhalterstraße 1\n12345 Stadt" },
        { "type": "textarea", "id": "hours", "label": "Öffnungszeiten", "default": "Mo–Sa 10–19 Uhr" },
        { "type": "url", "id": "link", "label": "Link zur Route" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Standorte",
      "blocks": [{ "type": "store" }, { "type": "store" }, { "type": "store" }]
    }
  ]
}
{% endschema %}
