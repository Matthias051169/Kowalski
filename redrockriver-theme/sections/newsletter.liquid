<section class="section container newsletter">
  <div class="newsletter__inner">
    <h2 class="display-s">{{ section.settings.heading | escape }}</h2>
    {%- if section.settings.text != blank -%}<p>{{ section.settings.text | escape }}</p>{%- endif -%}

    {%- form 'customer', id: 'NewsletterForm', class: 'newsletter__form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      {%- if form.posted_successfully? -%}
        <p class="form-status" role="status">{{ 'newsletter.success' | t }}</p>
      {%- else -%}
        {%- if form.errors -%}
          <p class="form-status form-status--error" role="alert">{{ form.errors | default_errors }}</p>
        {%- endif -%}
        <label class="visually-hidden" for="NewsletterEmail">{{ 'newsletter.email' | t }}</label>
        <div class="newsletter__row">
          <input id="NewsletterEmail" class="field" type="email" name="contact[email]" autocomplete="email" placeholder="{{ 'newsletter.email' | t }}" required>
          <button class="button" type="submit">{{ 'newsletter.submit' | t }}</button>
        </div>
        <label class="checkbox">
          <input type="checkbox" name="consent" required>
          <span>{{ 'newsletter.consent' | t }}</span>
        </label>
      {%- endif -%}
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Bleib auf dem Laufenden" },
    { "type": "text", "id": "text", "label": "Text", "default": "Platzhaltertext. Hier steht später der Nutzen des Newsletters." }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}
