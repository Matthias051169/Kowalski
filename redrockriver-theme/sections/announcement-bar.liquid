{%- if section.settings.text != blank -%}
  <div class="announcement" role="region" aria-label="Ankündigung">
    {%- if section.settings.link != blank -%}
      <a class="announcement__inner label" href="{{ section.settings.link }}">{{ section.settings.text | escape }}</a>
    {%- else -%}
      <p class="announcement__inner label">{{ section.settings.text | escape }}</p>
    {%- endif -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Ankündigungsleiste",
  "settings": [
    { "type": "text", "id": "text", "label": "Text", "default": "PLATZHALTER: Hier steht deine Ankündigung" },
    { "type": "url", "id": "link", "label": "Link" }
  ]
}
{% endschema %}
