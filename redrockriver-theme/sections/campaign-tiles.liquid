<section class="section container">
  <ul class="tiles tiles--{{ section.settings.columns }}">
    {%- for block in section.blocks -%}
      <li class="tile" {{ block.shopify_attributes }}>
        <a class="tile__link" href="{{ block.settings.link | default: routes.all_products_collection_url }}">
          <div class="tile__media" aria-hidden="true">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '400, 700, 1000, 1400', sizes: '(min-width: 990px) 33vw, 100vw', class: 'tile__img', alt: '' }}
            {%- else -%}
              {{ 'lifestyle-1' | placeholder_svg_tag: 'tile__img placeholder' }}
            {%- endif -%}
          </div>
          <div class="tile__text">
            <h3 class="tile__heading display-s">{{ block.settings.heading | escape }}</h3>
            <span class="link label">{{ block.settings.link_label | escape }}</span>
          </div>
        </a>
      </li>
    {%- endfor -%}
  </ul>
</section>

{% schema %}
{
  "name": "Kampagnenkacheln",
  "max_blocks": 4,
  "settings": [
    {
      "type": "select", "id": "columns", "label": "Kacheln pro Reihe (Desktop)",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "3"
    }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Kachel",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Bild" },
        { "type": "text", "id": "heading", "label": "Überschrift", "default": "Kampagne" },
        { "type": "text", "id": "link_label", "label": "Link-Text", "default": "Ansehen" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Kampagnenkacheln",
      "blocks": [{ "type": "tile" }, { "type": "tile" }, { "type": "tile" }]
    }
  ]
}
{% endschema %}
